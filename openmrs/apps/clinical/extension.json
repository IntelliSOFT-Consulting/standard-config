  "bahmniClinicalBillingTreatment": {
    "id": "bahmni.clinical.billing.treatment",
    "extensionPointId": "org.bahmni.clinical.consultation.board",
    "type": "link",
    "label": "Medications",
    "translationKey": "MEDICATIONS_BOARD_LABEL_KEY",
    "extensionParams": {
      "tabConfigName": "allMedicationTabConfig",
      "sections": {
        "basicDetails": {
          "translationKey": "DASHBOARD_TITLE_BASIC_DETAILS_KEY",
          "type": "observation",
          "isObservation": true,
          "displayOrder": 1,
          "dashboardConfig": {
            "conceptNames": ["Height (cm)", "Weight (kg)"],
            "displayNameType": "FSN",
            "showDetailsButton": true,
            "numberOfVisits": 2
          },
          "expandedViewConfig": {
            "conceptNames": ["Height (cm)", "Weight (kg)", "Body mass index", "BMI STATUS"],
            "scope": "latest",
            "showDetailsButton": true,
            "displayNameType": "FSN",
            "pivotTable": {}
          },
          "hideEmptyDisplayControl": true
        },
        "allergies": {
          "type": "allergies",
          "displayOrder": 2
        }
      }
    },
    "url": "treatment",
    "icon": "fa-user-md",
    "order": 7,
    "requiredPrivilege": "app:clinical:treatmentTab"
  },
